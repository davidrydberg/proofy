flowchart LR
  describe["<b>1. You describe it</b><br/>a guest can check out<br/>and gets an email<br/><br/><i>Tests start from what you<br/>want, not from the code</i>"]
  write["<b>2. Your agent writes them</b><br/>any coding agent: R1..Rn,<br/>a Playwright test, fakes<br/><br/><i>No hand-written<br/>end-to-end tests</i>"]
  approve["<b>3. You approve</b><br/>results and what the agent<br/>assumed, after 3 identical runs<br/><br/><i>The agent never marks<br/>its own homework</i>"]
  run["<b>4. proofy runs them</b><br/>Playwright in sealed Docker,<br/>no AI, on every change<br/><br/><i>Same answer every run,<br/>nothing leaks out</i>"]
  report["<b>5. Result on your PR</b><br/>per requirement: asked,<br/>happened, screenshots<br/><br/><i>Proof you can review,<br/>not just a green tick</i>"]

  describe --> write --> approve --> run --> report
